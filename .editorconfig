root = true

# Records the style trek-planner already uses (ISD-25). Editors apply these
# rules to new edits; nothing here reformats an existing file.

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
indent_size = 2
